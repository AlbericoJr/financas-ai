# Desenvolvimento local: copie para .env (nunca publique o arquivo real).
PORT=3000
NODE_ENV=development
SESSION_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Apenas no servidor de produção:
APP_ORIGIN=
API_ONLY=false
DATA_DIR=
# API_ORIGIN: configure somente na Vercel, com a origem HTTPS pública da API.
