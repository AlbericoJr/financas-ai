{
  "name": "financas-ai",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --experimental-strip-types --watch server/local.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types server/local.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^3.0.2",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.4",
    "@google/genai": "^1.0.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0"
  }
}
